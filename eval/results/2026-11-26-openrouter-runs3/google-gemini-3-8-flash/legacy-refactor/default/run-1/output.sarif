{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "invocations": [
        {
          "executionSuccessful": false,
          "properties": {
            "incompleteReason": "iteration_limit"
          }
        }
      ],
      "properties": {
        "incomplete": true,
        "status": "incomplete"
      },
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/db.py"
                },
                "region": {
                  "endLine": 25,
                  "startLine": 24
                }
              }
            }
          ],
          "message": {
            "text": "Bare except clause catches all exceptions and silently returns None without proper error handling or logging."
          },
          "ruleId": "bare-except"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/db.py"
                },
                "region": {
                  "endLine": 20,
                  "startLine": 20
                }
              }
            }
          ],
          "message": {
            "text": "SQL query constructed using f-string string formatting with unescaped variable `name`, vulnerable to SQL injection."
          },
          "ruleId": "sql-injection"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/liuyanghejerry/Clausura",
          "name": "Clausura"
        }
      }
    }
  ],
  "version": "2.1.0"
}