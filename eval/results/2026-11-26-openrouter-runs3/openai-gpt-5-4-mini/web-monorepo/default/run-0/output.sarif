          ],
          "message": {
            "text": "User-controlled profile bio is assigned directly to `innerHTML`, allowing stored XSS if the API returns HTML or script content."
          },
          "ruleId": "xss"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
