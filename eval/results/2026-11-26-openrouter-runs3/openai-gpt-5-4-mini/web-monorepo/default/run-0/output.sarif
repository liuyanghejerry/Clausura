        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/api/src/server.ts"
                },
                "region": {
                  "endLine": 6,
                  "startLine": 6
                }
              }
            }
          ],
          "message": {
            "text": "A hardcoded service API key is embedded in the server source, which risks credential leakage if the repo is shared."
