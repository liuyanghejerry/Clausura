                },
                "region": {
                  "endLine": 29,
                  "startLine": 29
                }
              }
            }
          ],
          "message": {
            "text": "Untrusted comment HTML is rendered via `dangerouslySetInnerHTML`, which can execute attacker-controlled markup and scripts."
          },
          "ruleId": "xss"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/web/src/components/Chat.tsx"
                },
                "region": {
                  "endLine": 28,
                  "startLine": 26
                }
              }
            }
          ],
          "message": {
            "text": "Chat messages are concatenated into HTML and written to `innerHTML`, so attacker-controlled sender/text fields can trigger stored XSS."
          },
          "ruleId": "xss"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/api/src/routes/users.ts"
                },
                "region": {
                  "endLine": 11,
                  "startLine": 11
                }
              }
            }
          ],
          "message": {
            "text": "The route interpolates `req.params.id` directly into SQL, enabling SQL injection through the path parameter."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/api/src/server.ts"
                },
                "region": {
                  "endLine": 19,
                  "startLine": 19
                }
              }
            }
          ],
          "message": {
            "text": "The query concatenates the `name` request parameter into SQL, allowing SQL injection via crafted query strings."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
