          "message": {
            "text": "Chained `unwrap()` calls on `strip_prefix` and `parse` for the order SKU. A SKU without the \"SKU-\" prefix or with a non-numeric suffix panics. `order.items[0]` also panics on an empty items list. The function already returns a `Result`."
          },
          "ruleId": "panic-unwrap"
