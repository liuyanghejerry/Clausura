          "message": {
            "text": "`strip_prefix(...).unwrap().parse().unwrap()` on the user-supplied SKU panics when the prefix is missing or the number is invalid. `items[0]` also panics on an empty order. Both should return an error."
          },
          "ruleId": "panic-unwrap"
        },
