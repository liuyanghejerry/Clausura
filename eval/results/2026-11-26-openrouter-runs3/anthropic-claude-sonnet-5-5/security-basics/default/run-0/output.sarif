{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/login.js"
                },
                "region": {
                  "endLine": 9,
                  "startLine": 7
                }
              }
            }
          ],
          "message": {
            "text": "SQL query is built by concatenating the unsanitized `username` parameter. Use parameterized queries."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/login.js"
                },
                "region": {
                  "endLine": 13,
                  "startLine": 13
                }
              }
            }
          ],
          "message": {
            "text": "API key is hardcoded in source and exported. Load it from a secret store or environment variable instead."
          },
          "ruleId": "hardcoded-secret"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render.js"
                },
                "region": {
                  "endLine": 5,
                  "startLine": 5
                }
              }
            }
          ],
          "message": {
            "text": "User-controlled `user.bio` is assigned to innerHTML without escaping, which allows stored XSS. Use textContent or sanitize the value."
          },
          "ruleId": "xss"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/liuyanghejerry/Clausura",
          "name": "Clausura"
