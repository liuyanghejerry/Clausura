          "message": {
            "text": "SQL injection: query-string value `req.query.name` is concatenated into the SQL text (inside quotes) and executed unparameterized, allowing `'; DROP TABLE users; --`-style injection. Use `pool.query(\"SELECT * FROM users WHERE name = $1\", [name])`."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
