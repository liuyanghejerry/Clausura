                  "startLine": 19
                }
              }
            }
          ],
          "message": {
            "text": "Stored XSS: the user `bio` loaded from /api/users/{userId}/profile is assigned straight to `innerHTML` on a DOM node, so any markup/script in the bio executes. Use React text rendering ({bio}) or textContent."
          },
          "ruleId": "xss"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
