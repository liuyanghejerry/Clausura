                },
                "region": {
                  "endLine": 29,
                  "startLine": 29
                }
              }
            }
          ],
          "message": {
            "text": "XSS: server-provided comment body is injected with `dangerouslySetInnerHTML` without any sanitization (no DOMPurify / trusted-HTML allowlist). Any HTML/script stored in `c.html` runs in the victim's session."
          },
          "ruleId": "xss"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/web/src/components/Profile.tsx"
