                  "startLine": 11
                }
              }
            }
          ],
          "message": {
            "text": "SQL injection: `req.params.id` is interpolated into the query text with a template literal and executed by pool.query. Use a parameterized query: `pool.query(\"SELECT ... WHERE id = $1\", [id])`."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
            {
