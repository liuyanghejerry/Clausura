          "message": {
            "text": "Stored XSS: comment HTML fetched from the API is rendered unsanitized via dangerouslySetInnerHTML; server/user-supplied markup is injected straight into the page."
          },
          "ruleId": "xss"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
