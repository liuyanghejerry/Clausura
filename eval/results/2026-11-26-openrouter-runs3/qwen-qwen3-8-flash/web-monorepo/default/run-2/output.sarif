          "message": {
            "text": "Hardcoded signing secret in source: AUTH_SECRET is a literal \"sk-...\" value used to sign and verify payloads; anyone with repo read access can forge valid signatures. Load from a secret manager/env var and rotate."
          },
          "ruleId": "hardcoded-secret"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/api/src/server.ts"
                },
                "region": {
                  "endLine": 7,
                  "startLine": 7
