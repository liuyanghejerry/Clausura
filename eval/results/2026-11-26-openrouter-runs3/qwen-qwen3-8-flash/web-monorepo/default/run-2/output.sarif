          "message": {
            "text": "Explicit `any` used in shared utilities: parseJson returns `any` and mergeOptions takes/returns `any`, erasing types for every api and web caller. Use `unknown` plus generics/Record<string, unknown>."
          },
          "ruleId": "no-explicit-any"
        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/web/src/hooks/useFetch.ts"
                },
                "region": {
                  "endLine": 15,
                  "startLine": 4
                }
              }
            }
          ],
          "message": {
            "text": "Explicit `any` in the shared fetch hook: the generic defaults to `any` (T = any) so every call site without a type argument loses response typing, and the parsed body is annotated `any`. Default to `unknown`."
          },
          "ruleId": "no-explicit-any"
        },
        {
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
