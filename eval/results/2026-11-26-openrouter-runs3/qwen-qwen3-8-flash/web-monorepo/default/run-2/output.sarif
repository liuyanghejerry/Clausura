          "message": {
            "text": "Stored XSS: chat message sender/text (user-controlled, fetched from /api/rooms/:id/messages) are interpolated into an HTML string and assigned directly to innerHTML, so any markup/script in a message executes in the DOM."
          },
          "ruleId": "xss"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
