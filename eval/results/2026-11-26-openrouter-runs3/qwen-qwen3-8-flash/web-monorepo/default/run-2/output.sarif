          "message": {
            "text": "SQL injection: the route parameter req.params.id is interpolated into the query via a template literal and passed to pool.query with no parameterization or validation."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "packages/api/src/server.ts"
                },
                "region": {
                  "endLine": 21,
                  "startLine": 18
                }
              }
            }
          ],
          "message": {
            "text": "SQL injection: req.query.name is concatenated into a quoted string literal in the query text. Use a parameterized query: pool.query(\"SELECT * FROM users WHERE name = $1\", [name])."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
