              }
            }
          ],
          "message": {
            "text": "Hardcoded API key committed in source: SERVICE_API_KEY is a literal secret exported from the server entry point (and thus also bundled/shipped). Move to environment/secret store and revoke the leaked value."
          },
          "ruleId": "hardcoded-secret"
        },
        {
