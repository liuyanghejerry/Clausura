                  "startLine": 16
                }
              }
            }
          ],
          "message": {
            "text": "Debug `print()` calls remain in the session load/save helpers; `print(f\"saved {path}\")` writes filesystem paths to stdout on every save. Route through `logging` and keep the path at DEBUG level only."
          },
          "ruleId": "debug-print"
        },
        {
          "level": "note",
          "locations": [
