          "message": {
            "text": "Remaining debug prints in the entry point and payments module: `print(f\"user: {user}\")` emits PII (name + email) to stdout for every user, and the payments prints expose account/charge identifiers. Replace with `logging` calls using non-PII fields (user id only)."
          },
          "ruleId": "debug-print"
