                },
                "region": {
                  "endLine": 20,
                  "startLine": 18
                }
              }
            }
          ],
          "message": {
            "text": "db.list_users() failure is caught by a broad `except Exception` and degraded to an empty list with only a print; the exception type/message is lost. Catch sqlite3.Error, log it with the exception details (logging.exception), and fail loudly."
          },
          "ruleId": "bare-except"
        },
