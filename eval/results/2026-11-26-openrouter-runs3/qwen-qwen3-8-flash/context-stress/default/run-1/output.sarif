{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "invocations": [
        {
          "executionSuccessful": false,
          "properties": {
            "incompleteReason": "iteration_limit"
          }
        }
      ],
      "properties": {
        "incomplete": true,
        "status": "incomplete"
      },
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "data/records.json"
                },
                "region": {
                  "endLine": 9808,
                  "startLine": 9808
                }
              }
            }
          ],
          "message": {
            "text": "Hardcoded API key committed in data/records.json (record rec-1400): \"api_key\": \"sk-eval-seeded-secret-8f3a1c9d\". Secrets stored in data fixtures are readable by anyone consuming the file and persist in git history; move the value to a secret manager / environment variable and reference it by name (e.g. \"api_key\": \"${API_KEY}\")."
          },
          "ruleId": "hardcoded-secret"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/liuyanghejerry/Clausura",
          "name": "Clausura"
        }
