                }
              }
            }
          ],
          "message": {
            "text": "panic-unwrap: `serde_json::from_str(&body).unwrap()` on a fully user-controlled POST body. Any malformed JSON body panics the server. Propagate the error and respond 400 Bad Request."
          },
          "ruleId": "panic-unwrap"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
