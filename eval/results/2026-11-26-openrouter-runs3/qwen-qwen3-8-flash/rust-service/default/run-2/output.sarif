                  "startLine": 48
                }
              }
            }
          ],
          "message": {
            "text": "SQL injection: caller-supplied `domain` is concatenated into a LIKE string literal. Beyond quote breakout, unescaped % / _ let a caller widen the match (domain = \"%\" dumps every user's email/username). Fix: build the pattern in Rust and bind it: prepare(\"... WHERE email LIKE ?1\") with query_map([pattern], ...), escaping LIKE wildcards."
          },
          "ruleId": "sql-injection"
        },
        {
