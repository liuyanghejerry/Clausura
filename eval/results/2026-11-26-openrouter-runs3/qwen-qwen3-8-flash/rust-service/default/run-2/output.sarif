                  "startLine": 68
                }
              }
            }
          ],
          "message": {
            "text": "One statement with three panic sources: order.items[0] indexes without a length check (empty items panics), strip_prefix(\"SKU-\").unwrap() panics for any sku lacking the \"SKU-\" prefix, and .parse().unwrap() panics for a non-numeric suffix (e.g. \"SKU-ABC\"). The fn already returns rusqlite::Result, so convert these to errors via ok_or_else + `?` instead of unwrapping."
          },
          "ruleId": "panic-unwrap"
        },
