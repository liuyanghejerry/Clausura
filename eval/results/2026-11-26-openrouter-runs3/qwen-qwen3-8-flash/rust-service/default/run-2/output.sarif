          ],
          "message": {
            "text": "SQL injection: username is interpolated into the query with format!() and prepared with zero bound parameters. A value such as `' OR 1=1 --` (reachable from GET /users/<name>, handlers.rs:22-24) or stacked/UNION payloads alters statement semantics. Fix: static SQL + bind, e.g. prepare(\"SELECT id, username, email, active FROM users WHERE username = ?1\") and query_row([username], ...)."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
