                  "startLine": 36
                }
              }
            }
          ],
          "message": {
            "text": "unwrap() on deserializing the raw request body: any malformed or non-JSON POST /orders payload panics the connection handler, giving a remote attacker a trivial crash/DoS primitive. Fix: match on serde_json::from_str(&body) (or .map_err) and return 400 Bad Request."
          },
          "ruleId": "panic-unwrap"
        },
        {
          "level": "error",
