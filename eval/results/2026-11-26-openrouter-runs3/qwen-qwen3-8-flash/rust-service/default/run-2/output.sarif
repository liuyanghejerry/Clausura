          "message": {
            "text": "unwrap() on parsing a user-controlled path segment: any request to /users/<non-numeric> (e.g. \"/users/abc\", \"/users/1;2\") panics. Fix: `let Ok(id) = path.trim_start_matches(\"/users/\").parse::<u64>() else { write response 400; continue; };`"
          },
          "ruleId": "panic-unwrap"
        },
        {
          "level": "error",
