                }
              }
            }
          ],
          "message": {
            "text": "sql-injection: find_users_by_domain concatenates the untrusted `domain` argument into the SQL string inside a LIKE literal. Injecting `' OR 1=1 --` returns the entire users table. Use a bound parameter with the wildcard built in the value: \"... WHERE email LIKE ?1\" with format!(\"%{domain}\") passed as the parameter."
          },
          "ruleId": "sql-injection"
        },
