              }
            }
          ],
          "message": {
            "text": "panic-unwrap: insert_order unwraps both strip_prefix(\"SKU-\") and parse::<i64>() on caller-supplied order data (and indexes items[0] without a length check, itself a panic). A sku like \"ABC-123\" or an empty items vec crashes the process instead of returning an error. Both unwraps in this statement count as one finding; propagate as rusqlite::Error/invalid-data error instead."
          },
          "ruleId": "panic-unwrap"
        },
        {
          "level": "note",
          "locations": [
