                }
              }
            }
          ],
          "message": {
            "text": "sql-injection: find_user builds SQL by interpolating the caller-supplied `username` directly into the statement string. A value such as `' OR 1=1 --` changes the query semantics (auth/lookup bypass, data exfiltration). Use a parameterized query: conn.prepare(\"... WHERE username = ?1\")?.query_map([username], ...)."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
