{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "results": [
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/login.js"
                },
                "region": {
                  "endLine": 10,
                  "startLine": 6
                }
              }
            }
          ],
          "message": {
            "text": "SQL injection: `findByUsername` builds the SELECT statement by concatenating the untrusted `username` argument directly into the query string and passes it to `db.query()`. No parameterization, escaping, or validation is applied, so an input like `' OR '1'='1' --` alters the query logic and allows authentication bypass / data exfiltration."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/login.js"
                },
                "region": {
                  "endLine": 15,
                  "startLine": 13
                }
              }
            }
          ],
          "message": {
            "text": "Hardcoded secret: a literal API key (`sk-...`) is committed in source and exported from the module, exposing it to anyone with repo/build access and persisting it in git history. Move it to an environment variable or a secrets manager (e.g. `process.env.SERVICE_API_KEY`) and rotate the value."
          },
          "ruleId": "hardcoded-secret"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/render.js"
                },
                "region": {
                  "endLine": 5,
                  "startLine": 3
                }
              }
            }
          ],
          "message": {
            "text": "Stored XSS: `renderUserProfile` assigns the user-controlled `user.bio` directly to `innerHTML`, so any `<script>`/`<img onerror=...>` payload stored in the profile executes in other users' browsers (session/cookie theft, DOM takeover). Use `textContent`, or sanitize the HTML server-side/client-side with a vetted sanitizer before insertion."
          },
          "ruleId": "xss"
        }
      ],
      "tool": {
        "driver": {
          "informationUri": "https://github.com/liuyanghejerry/Clausura",
          "name": "Clausura"
        }
      }
    }
  ],
  "version": "2.1.0"
}