            }
          ],
          "message": {
            "text": "Hardcoded API credential `SERVICE_API_KEY` is committed in source and exported from the module. Load secrets from environment variables or a secret manager."
          },
          "ruleId": "hardcoded-secret"
        },
        {
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
