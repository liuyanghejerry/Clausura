          "message": {
            "text": "`findByUsername` builds the SQL query by concatenating the caller-supplied `username` directly into the statement, allowing SQL injection (e.g. `' OR '1'='1`). Use parameterized queries/placeholders instead."
          },
          "ruleId": "sql-injection"
        },
        {
          "level": "error",
          "locations": [
